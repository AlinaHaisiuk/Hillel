<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Articles list</title>
  </head>
  <body>
    <h1>Articles</h1>
    <ul>
      <% articles.forEach(article => { %>
      <li><a href="/articles/<%= article.id %>"><%= article.title %></a></li>
      <% }) %>
    </ul>
  </body>
</html>
